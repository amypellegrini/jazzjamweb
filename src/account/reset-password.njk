---
layout: account.njk
title: Choose a new password
description: Choose a new password for your JazzJam account.
permalink: /account/reset-password/
---
      <form method="post" action="/auth/update-password">
        <label for="password">New password</label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="new-password"
          minlength="6"
          aria-describedby="password-hint"
          required
        />
        <p class="hint" id="password-hint">At least 6 characters.</p>
        <button type="submit">Save new password</button>
      </form>
