<museScore version="4.40">
  <Style>
    <!-- Examples on several lines (the exercises): keep the lines close instead of spreading
         them down the page. -->
    <enableVerticalSpread>0</enableVerticalSpread>
    <minSystemDistance>6</minSystemDistance>
    <maxSystemDistance>8</maxSystemDistance>
  </Style>
</museScore>
