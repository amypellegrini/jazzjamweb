<!doctype html>
<html lang="en">
  <head>
    {% set current = lessons[lesson - 1] %}
    {% set pageTitle = current.title + " - Piano Block Chords - Jazz Jam Studio" %}
    {% include "block-chords/head.njk" %}
    <style>
{% include "block-chords/base.css" %}
      figure {
        margin: 1.5rem 0;
      }
      .example-title {
        font:
          700 0.95rem/1.3 system-ui,
          -apple-system,
          sans-serif;
        margin-bottom: 0.4rem;
      }
      figure img {
        width: 100%;
        height: auto;
        display: block;
      }
      figure audio {
        width: 100%;
        margin-top: 0.5rem;
      }
      figcaption {
        font:
          0.875rem/1.4 "Accidentals",
          system-ui,
          sans-serif;
        color: #666;
        margin-top: 0.25rem;
      }
      /* The pianists the introduction names, side by side with their names (as in the video). */
      .pianists {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        align-items: start;
        margin: 1.5rem 0;
      }
      .person {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.35rem;
        text-align: center;
      }
      .person img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 4 / 5;
        object-fit: cover;
        object-position: top;
        border-radius: 10px;
      }
      .person-name {
        font:
          600 1rem "Outfit",
          sans-serif;
      }
      .person-credit {
        font:
          400 0.75rem/1.3 "Outfit",
          sans-serif;
        color: #5a6b7d;
      }
      .person-credit a {
        color: inherit;
      }
      @media (max-width: 30rem) {
        .pianists {
          gap: 0.75rem;
        }
        .person-name {
          font-size: 0.85rem;
        }
      }
      /* Technique subtitle: the one-line goal under each technique's heading. Same voice as the
         lede, a step smaller and without its icon, sitting close to the heading it belongs to. */
      .subtitle {
        font-size: 1.1rem;
        line-height: 1.4;
        color: #6b7280;
        font-style: italic;
        font-weight: 600;
        font-family: "Accidentals", "Source Serif 4", Georgia, serif;
        margin-top: -0.35rem;
        text-wrap: balance;
      }
      .passing {
        color: #2563eb;
        font-weight: 600;
      }

      /* Side notes: asides to the main explanation. The label is CSS-only, so it is not narrated. */
      .note > p {
        margin: 0 0 0.75rem;
      }
      .note > p:last-child {
        margin-bottom: 0;
      }
      .note {
        margin: 1.5rem 0;
        padding: 0.9rem 1.1rem;
        border-left: 4px solid #4a90c4;
        border-radius: 0 6px 6px 0;
        background: #f1f6fb;
        font-size: 0.975rem;
        color: #333;
      }
      .note::before {
        content: "Note";
        display: block;
        margin-bottom: 0.25rem;
        font:
          600 0.75rem system-ui,
          sans-serif;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #3670a0;
      }

      /* Exercises: collapsible practice tasks, set apart from the explanation in a warm tint. */
      .exercise {
        margin: 1.75rem 0;
        border: 1px solid #e6c98f;
        border-radius: 8px;
        background: #fdf6e7;
      }
      .exercise summary {
        cursor: pointer;
        list-style: none;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.85rem 1.1rem;
        font:
          600 1rem/1.3 system-ui,
          sans-serif;
        color: #5b3d07;
      }
      .exercise summary::-webkit-details-marker {
        display: none;
      }
      .exercise summary::after {
        content: "";
        margin-left: auto;
        width: 0.55rem;
        height: 0.55rem;
        border-right: 2px solid currentColor;
        border-bottom: 2px solid currentColor;
        transform: rotate(45deg);
        transition: transform 0.15s;
      }
      .exercise[open] summary::after {
        transform: rotate(-135deg);
      }
      .exercise summary:focus-visible {
        outline: 2px solid #b7791f;
        outline-offset: 2px;
        border-radius: 8px;
      }
      .exercise-label {
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #fff;
        background: #b7791f;
        border-radius: 999px;
        padding: 0.15rem 0.6rem;
      }
      .exercise-body {
        padding: 0 1.1rem 1rem;
      }
      .exercise-body p:first-child {
        margin-top: 0;
      }
      figure.detail {
        min-width: min(100%, 16rem);
        margin-left: auto;
        margin-right: auto;
      }
      .exercise figure {
        background: #fff;
        border-radius: 6px;
        padding: 0.5rem;
      }

      /* Read-along mode */
      .score {
        position: relative;
      }
      .score svg {
        width: 100%;
        height: auto;
        display: block;
      }
      .score svg path.Note.sounding {
        fill: #e8590c;
      }
      /* Keyboard chart under each example (piano-chord-charts, compact): the keys of the chord
         being played light up with its noteheads, in the generator's own highlight colour.
         Drawn at its natural size, never wider than the example. */
      .keyboard svg {
        display: block;
        max-width: 100%;
        height: auto;
        margin: 0.6rem auto 0;
      }
      .keyboard rect.sounding {
        fill: #a0c6e8 !important; /* over the chart's inline key colours */
      }
      .reading {
        background: #fffbea;
        box-shadow: 0 0 0 0.5rem #fffbea;
        border-radius: 2px;
      }
      .w {
        border-radius: 3px;
      }
      .w.on {
        background: #ffe066;
      }
      body.readalong article > :is(h1, h2, h3, p, aside, figure) {
        cursor: pointer;
      }
      #listen {
        position: fixed;
        right: 1rem;
        bottom: 1rem;
        z-index: 1;
        font:
          600 1rem system-ui,
          sans-serif;
        padding: 0.75rem 1.25rem;
        border: 0;
        border-radius: 999px;
        background: #1d1d1f;
        color: #fff;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
        cursor: pointer;
      }
      #listen[hidden] {
        display: none;
      }

      /* Course: where this lesson sits, above it, and the step to the next one, below it. */
      .course-eyebrow {
        margin: 0 0 -1rem;
        font:
          600 0.8rem system-ui,
          -apple-system,
          sans-serif;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #6b7280;
      }
      .course-eyebrow a {
        color: inherit;
      }
      .lesson-nav {
        margin: 3rem 0 4rem; /* the footer's own top margin is auto */
        padding-top: 1.5rem;
        border-top: 1px solid #e5e7eb;
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
      }
      .lesson-nav-steps {
        display: flex;
        gap: 1rem;
        justify-content: space-between;
      }
      .lesson-nav-steps a {
        flex: 1 1 0;
        max-width: 50%;
        padding: 0.75rem 1rem;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        color: #1d1d1f;
        font-weight: 600;
        line-height: 1.3;
        text-decoration: none;
      }
      .lesson-nav-steps a:hover,
      .lesson-nav-steps a:focus-visible {
        border-color: #2563eb;
        color: #2563eb;
      }
      .lesson-nav-steps a[rel="next"] {
        margin-left: auto;
        text-align: right;
      }
      .lesson-nav-step {
        display: block;
        font-size: 0.8rem;
        font-weight: 500;
        color: #6b7280;
      }
      /* Course index: a sidebar left of the lesson on wide screens, folded above it otherwise. */
      .lesson-layout {
        position: relative;
      }
      .course-index {
        margin: 0 0 1.5rem;
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
      }
      .course-index details {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 0.6rem 1rem;
      }
      .course-index summary {
        cursor: pointer;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #6b7280;
      }
      .course-index ol {
        margin: 0.5rem 0 0.25rem;
        padding-left: 1.4rem;
        font-size: 0.95rem;
        line-height: 1.4;
      }
      .course-index li + li {
        margin-top: 0.55rem;
      }
      .course-index ol a {
        color: #2563eb;
        text-decoration: none;
      }
      .course-index ol a:hover {
        text-decoration: underline;
      }
      .course-index ol a[aria-current="page"] {
        color: #1d1d1f;
        font-weight: 600;
      }
      @media (min-width: 80rem) {
        /* Spans the lesson's height so its sticky list stays in view down to the exercise. */
        .course-index {
          position: absolute;
          top: 0;
          bottom: 0;
          right: calc(100% + 3rem);
          width: 13rem;
          margin: 0;
        }
        .course-index details {
          position: sticky;
          top: 2rem;
          border: 0;
          border-left: 2px solid #e5e7eb;
          border-radius: 0;
          padding: 0 0 0 1rem;
        }
        .course-index summary {
          cursor: default;
          list-style: none;
        }
        .course-index summary::-webkit-details-marker {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    {% include "block-chords/header.njk" %}
    <div class="lesson-layout">
      <nav class="course-index" aria-label="Course contents">
        <details open>
          <summary>Course contents</summary>
          <ol>
            {% for item in lessons %}
            <li>
              <a href="{{ item.url }}"{% if loop.index == lesson %} aria-current="page"{% endif %}>{{ item.title }}</a>
            </li>
            {% endfor %}
          </ol>
        </details>
      </nav>
      <script>
        // Always open as a sidebar on wide screens; folded by default above the lesson otherwise.
        // Without JavaScript the index simply stays open.
        (() => {
          const index = document.querySelector(".course-index details");
          const wide = matchMedia("(min-width: 80rem)");
          const sync = () => (index.open = wide.matches);
          sync();
          wide.addEventListener("change", sync);
          index.querySelector("summary").addEventListener("click", (e) => {
            if (wide.matches) e.preventDefault();
          });
        })();
      </script>
      <p class="course-eyebrow">
        <a href="/courses/block-chords/">Piano Block Chords</a> · Lesson
        {{ lesson }} of {{ lessons.length }}
      </p>
      <article
        data-narration="/assets/courses/block-chords/narration/{{ current.slug }}/"
        data-example-start="{{ current.exampleStart }}"
        data-exercise-start="{{ current.exerciseStart }}"
      >
{{ content | safe }}      </article>
    </div>
    <nav class="lesson-nav" aria-label="Previous and next lesson">
      <div class="lesson-nav-steps">
        {% if lesson > 1 %}{% set prev = lessons[lesson - 2] %}
        <a rel="prev" href="{{ prev.url }}"
          ><span class="lesson-nav-step">← Lesson {{ lesson - 1 }}</span
          ><span class="lesson-nav-title">{{ prev.title }}</span></a
        >
        {% endif %}{% if lesson < lessons.length %}{% set next = lessons[lesson] %}
        <a rel="next" href="{{ next.url }}"
          ><span class="lesson-nav-step">Lesson {{ lesson + 1 }} →</span
          ><span class="lesson-nav-title">{{ next.title }}</span></a
        >
        {% endif %}
      </div>
    </nav>
    {% include "block-chords/footer.njk" %}
    <button id="listen" type="button" hidden>▶ Listen</button>

    <script>
      // Read-along: narrates the lesson (pre-recorded with Kokoro TTS per lesson, see
      // scripts/narration/narrate.py), highlights each word as it is spoken, and plays each
      // example in turn with its noteheads lighting up chord by chord (timings from
      // scripts/sheet-music/block-chords.py).
      (async () => {
        const article = document.querySelector("article");
        const NARRATION = article.dataset.narration;
        // Each lesson is a slice of the article: these offsets keep its examples and exercises
        // numbered as they are in the article.
        const exampleStart = Number(article.dataset.exampleStart),
          exerciseStart = Number(article.dataset.exerciseStart);
        const blocks = [
          ...article.querySelectorAll(":scope > :is(h1, h2, h3, p, aside)"),
        ];
        // A note (aside) may hold an example: it plays right after the note's text.
        const items = [
          ...article.querySelectorAll(
            ":scope > :is(h1, h2, h3, p, aside, figure)",
          ),
        ].flatMap((el) =>
          el.tagName === "ASIDE"
            ? [el, ...el.querySelectorAll("figure")]
            : [el],
        );
        // The narrated text of a block: a note with an example narrates only its paragraph.
        const textOf = (el) =>
          (el.tagName === "ASIDE" && el.querySelector(":scope > p")) || el;

        // Number the examples in page order so each one can be referred to as "Example N".
        // Exercises are not examples: they keep their own count, "Exercise N", on their label.
        [...article.querySelectorAll("figure")]
          .filter((fig) => !fig.closest(".exercise"))
          .forEach((fig, i) => {
            const title = document.createElement("div");
            title.className = "example-title";
            title.textContent = `Example ${exampleStart + i + 1}`;
            fig.prepend(title);
          });
        article.querySelectorAll(".exercise-label").forEach((label, i) => {
          label.textContent = `Exercise ${exerciseStart + i + 1}`;
        });

        // Every example lights up its sounding notes, whether played by read-along or by hand.
        // The SVG is inlined so its noteheads can be styled. The chord timings and x positions
        // come from <example>.cursor.json.
        for (const fig of article.querySelectorAll("figure")) {
          const img = fig.querySelector("img"),
            audio = fig.querySelector("audio");
          const wrap = document.createElement("div");
          wrap.className = "score";
          img.replaceWith(wrap);
          wrap.append(img);
          let events = [],
            heads = []; // heads[i] = noteheads of chord i
          const src = img.getAttribute("src");
          Promise.all([
            fetch(src.replace(/\.svg$/, ".cursor.json")).then((r) => r.json()),
            fetch(src).then((r) => r.text()),
          ])
            .then(([ev, text]) => {
              events = ev;
              const svg = new DOMParser().parseFromString(
                text,
                "image/svg+xml",
              ).documentElement;
              svg.removeAttribute("width");
              svg.removeAttribute("height");
              svg.setAttribute("role", "img");
              svg.setAttribute("aria-label", img.alt);
              img.replaceWith(svg);
              // Detail figures keep their natural width: the notation is drawn at one size across
              // them (a full-width example is 8217 units wide; details are shown 1.3x larger).
              if (fig.classList.contains("detail")) {
                fig.style.width =
                  Math.min(100, (svg.viewBox.baseVal.width / 8217) * 130) + "%";
              }
              // Assign each notehead to the chord whose x position is nearest (paths start at the
              // head's left edge; heads are ~107 units wide, chords several hundred apart). On a
              // score with several lines, only chords on the head's own (nearest) line compete.
              const { width, height } = svg.viewBox.baseVal;
              const lineMid = (e) =>
                e.top == null ? 50 : (e.top + e.bottom) / 2;
              heads = events.map(() => []);
              for (const head of svg.querySelectorAll("path.Note")) {
                const [hx, hy] = head
                  .getAttribute("d")
                  .slice(1)
                  .split(/[ ,L]/)
                  .map(parseFloat);
                const x = ((hx + 54) / width) * 100,
                  y = (hy / height) * 100;
                const line = Math.min(
                  ...events.map((e) => Math.abs(lineMid(e) - y)),
                );
                let best = -1;
                events.forEach((e, i) => {
                  if (Math.abs(lineMid(e) - y) - line > 0.01) return;
                  if (
                    best < 0 ||
                    Math.abs(e.x - x) < Math.abs(events[best].x - x)
                  )
                    best = i;
                });
                heads[best].push(head);
              }
            })
            .catch(() => {}); // keep the plain <img> if anything fails
          // The keyboard chart beneath the score: keys[i] = the keys chord i plays (rendered by
          // scripts/keyboards/keyboard.js). Without it the example plays as before.
          const keyboard = document.createElement("div");
          keyboard.className = "keyboard";
          wrap.after(keyboard);
          let keys = [];
          Promise.all([
            fetch(src.replace(/\.svg$/, ".keys.json")).then((r) => r.json()),
            fetch(src.replace(/\.svg$/, ".keyboard.svg")).then((r) => r.text()),
          ])
            .then(([data, text]) => {
              const svg = new DOMParser().parseFromString(
                text,
                "image/svg+xml",
              ).documentElement;
              svg.setAttribute("aria-hidden", "true"); // the score carries the description
              keyboard.append(svg);
              const rects = svg.querySelectorAll("rect");
              keys = data.chords.map((chord) => chord.map((j) => rects[j]));
            })
            .catch(() => keyboard.remove());
          let lit = -1;
          const light = (i) => {
            if (i === lit) return;
            heads[lit]?.forEach((h) => h.classList.remove("sounding"));
            keys[lit]?.forEach((k) => k.classList.remove("sounding"));
            heads[i]?.forEach((h) => h.classList.add("sounding"));
            keys[i]?.forEach((k) => k.classList.add("sounding"));
            lit = i;
          };
          const tick = () => {
            const t = audio.currentTime;
            const i = audio.paused
              ? -1
              : events.findIndex((e) => t >= e.t && t < e.end);
            light(i);
            if (!audio.paused) requestAnimationFrame(tick);
          };
          audio.addEventListener("play", () => requestAnimationFrame(tick));
          audio.addEventListener("pause", tick);
          audio.addEventListener("ended", () => light(-1));
        }

        let manifest;
        try {
          manifest = await (await fetch(NARRATION + "narration.json")).json();
        } catch {
          return; // no narration: the page still works as a plain lesson
        }
        if (manifest.length !== blocks.length) return;

        // A recording belongs to the exact text it was made from: narrate.py stores the first
        // 12 hex digits of the SHA-1 of each block's text (a note's example aside). A block whose
        // text has changed since is left out of the read-along until it is re-recorded.
        const hashOf = async (block) => {
          const copy = block.cloneNode(true);
          copy.querySelectorAll("figure").forEach((f) => f.remove());
          const text = copy.textContent.trim().split(/\s+/).join(" ");
          const digest = await crypto.subtle.digest(
            "SHA-1",
            new TextEncoder().encode(text),
          );
          return [...new Uint8Array(digest)]
            .map((b) => b.toString(16).padStart(2, "0"))
            .join("")
            .slice(0, 12);
        };
        const hashes = await Promise.all(blocks.map(hashOf));
        hashes.forEach((hash, i) => {
          if (hash !== manifest[i].hash) manifest[i] = null;
        });

        // Wrap each displayed word in a span, matching the narration's word list.
        blocks.forEach((block, i) => {
          if (!manifest[i]) return;
          const el = textOf(block);
          const words = el.textContent.trim().split(/\s+/);
          if (words.length !== manifest[i].words.length)
            return (manifest[i] = null);
          el.textContent = "";
          words.forEach((w, j) => {
            if (j) el.append(" ");
            const s = document.createElement("span");
            s.className = "w";
            s.textContent = w;
            el.append(s);
          });
        });

        const button = document.getElementById("listen");
        const voice = new Audio();
        let current = -1,
          playing = false,
          media = null,
          raf = 0;

        const clear = () => {
          cancelAnimationFrame(raf);
          document
            .querySelectorAll(".reading")
            .forEach((e) => e.classList.remove("reading"));
          document
            .querySelectorAll(".w.on")
            .forEach((e) => e.classList.remove("on"));
        };
        const setButton = () =>
          (button.textContent = playing ? "❚❚ Pause" : "▶ Listen");

        const follow = (el, timings) => {
          const spans = el.querySelectorAll(".w");
          const step = () => {
            const t = voice.currentTime;
            timings.forEach(([s, e], j) =>
              spans[j].classList.toggle("on", t >= s && t < e),
            );
            if (!voice.paused) raf = requestAnimationFrame(step);
          };
          raf = requestAnimationFrame(step);
        };

        const playItem = (i) => {
          clear();
          if (media) media.onended = null;
          voice.pause();
          items.forEach((it) => it.querySelector("audio")?.pause());
          current = i;
          if (i >= items.length) return stop();
          const el = items[i];
          el.classList.add("reading");
          el.scrollIntoView({ behavior: "smooth", block: "center" });
          if (el.tagName === "FIGURE") {
            media = el.querySelector("audio");
            media.currentTime = 0;
          } else {
            const n = blocks.indexOf(el);
            if (!manifest[n]) return playItem(i + 1); // text changed since narration was recorded
            media = voice;
            voice.src = NARRATION + `${n}.mp3`;
            voice.onplay = () => follow(el, manifest[n].words);
          }
          media.onended = () => playItem(i + 1);
          media.play();
        };

        const stop = () => {
          clear();
          playing = false;
          current = -1;
          document.body.classList.remove("readalong");
          setButton();
        };

        button.addEventListener("click", () => {
          if (!playing && current < 0) {
            document.body.classList.add("readalong");
            playing = true;
            playItem(0);
          } else if (playing) {
            media?.pause();
            playing = false;
          } else {
            media?.play();
            playing = true;
          }
          setButton();
        });

        // While read-along is on, clicking any block jumps there.
        article.addEventListener("click", (e) => {
          if (!document.body.classList.contains("readalong")) return;
          if (e.target.closest("audio")) return;
          const i = items.findIndex((it) => it.contains(e.target));
          if (i < 0) return;
          playing = true;
          setButton();
          playItem(i);
        });

        button.hidden = false;
      })();
    </script>
  </body>
