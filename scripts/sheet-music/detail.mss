<?xml version="1.0" encoding="UTF-8"?>
<museScore version="4.40">
  <Style>
    <!-- Chord symbols are labels only: playback is the notated voicings, never MuseScore's own
         realisation of the symbol. -->
    <harmonyPlay>0</harmonyPlay>
    <!-- Detail figures (a few chords side by side): never stretch the line to the page width,
         so every figure keeps natural spacing and the page can show them all at one size. -->
    <lastSystemFillLimit>1</lastSystemFillLimit>
    <enableIndentationOnFirstSystem>0</enableIndentationOnFirstSystem>
    <!-- Half and whole notes sit close by default; give the chords and their symbols room. -->
    <measureSpacing>2.4</measureSpacing>
  </Style>
</museScore>
