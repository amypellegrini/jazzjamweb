<!doctype html>
<html lang="en">
  <head>
    {% set pageTitle = "Piano Block Chords - Jazz Jam Studio" %}
    {% include "block-chords/head.njk" %}
    <style>
{% include "block-chords/base.css" %}
      /* Landing: the course's name, what it covers, and the way in. */
      .course-eyebrow {
        margin: 0 0 -1rem;
        font:
          600 0.8rem system-ui,
          -apple-system,
          sans-serif;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #6b7280;
      }
      .course-landing {
        margin-bottom: 4rem; /* the footer's own top margin is auto */
      }
      .course-landing h1 {
        font-size: 2.75rem;
        margin-bottom: 1rem;
      }
      .course-summary p {
        margin: 0 0 1rem;
      }
      .course-start {
        display: inline-block;
        margin-top: 1rem;
        padding: 0.8rem 1.6rem;
        border-radius: 8px;
        background: #2563eb;
        color: #fff;
        font:
          600 1.05rem system-ui,
          -apple-system,
          sans-serif;
        text-decoration: none;
      }
      .course-contents {
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e5e7eb;
      }
      .course-contents h2 {
        margin-top: 0;
      }
      .course-contents .course-part ol {
        margin: 0.5rem 0 0;
        padding-left: 1.4rem;
        line-height: 1.5;
      }
      .course-contents .course-part a {
        color: #2563eb;
        text-decoration: none;
      }
      .course-contents .course-part a:hover {
        text-decoration: underline;
      }
      .course-start:hover,
      .course-start:focus-visible {
        background: #1d4ed8;
      }
    </style>
  </head>
  <body>
    {% include "block-chords/header.njk" %}
    <main class="course-landing">
      <p class="course-eyebrow">Course · {{ parts.length }} parts</p>
      <h1>Piano Block Chords</h1>
{{ content | safe }}      <a class="course-start" href="{{ lessons[0].url }}">Start the course</a>
      <section class="course-contents" aria-labelledby="course-contents">
        <h2 id="course-contents">Course contents</h2>
{% include "block-chords/syllabus.njk" %}
      </section>
    </main>
    {% include "block-chords/footer.njk" %}
  </body>
</html>
