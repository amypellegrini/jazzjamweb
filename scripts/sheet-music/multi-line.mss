<?xml version="1.0" encoding="UTF-8"?>
<museScore version="4.40">
  <Style>
    <!-- Examples on several lines (the exercises): keep the lines close instead of spreading
         them down the page. -->
    <!-- No first-line indent: every line starts at the same left edge. -->
    <enableIndentationOnFirstSystem>0</enableIndentationOnFirstSystem>
    <!-- Stretch the last line to full width like the first. -->
    <lastSystemFillLimit>0</lastSystemFillLimit>
    <enableVerticalSpread>0</enableVerticalSpread>
    <minSystemDistance>6</minSystemDistance>
    <maxSystemDistance>8</maxSystemDistance>
  </Style>
</museScore>
